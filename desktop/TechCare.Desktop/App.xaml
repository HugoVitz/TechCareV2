<Application x:Class="TechCare.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="CorPrincipal" Color="#2563EB" />
        <SolidColorBrush x:Key="CorFundo" Color="#F8FAFC" />
        <SolidColorBrush x:Key="CorTextoSuave" Color="#475569" />
        <BooleanToVisibilityConverter x:Key="BoolParaVisivel" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CorPrincipal}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Valor" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Resources>
</Application>
