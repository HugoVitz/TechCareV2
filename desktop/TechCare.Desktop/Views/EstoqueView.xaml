<UserControl x:Class="TechCare.Desktop.Views.EstoqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Recarregar" Command="{Binding CarregarCommand}" />
                <TextBlock Text="{Binding Mensagem}" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Rotulo}" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Produtos}" SelectedItem="{Binding Selecionado}" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False" Background="White">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Alerta}" Value="True">
                                <Setter Property="Background" Value="#FEF3C7" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produto" Binding="{Binding Nome, Mode=OneWay}" Width="*" />
                    <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat='R$ {0:N2}', Mode=OneWay}" Width="100" />
                    <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque, Mode=OneWay}" Width="80" />
                    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo, Mode=OneWay}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Cartao}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Estoque baixo (avisos do MonitorEstoque)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Alertas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#B45309" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cartao}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Ajustar estoque (procedure sp_ajustar_estoque)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Selecionado.Nome, TargetNullValue='Selecione um produto na lista'}" Margin="0,0,0,8" />
                        <TextBlock Text="Quantidade (+ entrada / - saída)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Motivo" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Aplicar ajuste" Command="{Binding AjustarCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cartao}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Movimentações (gravadas pela trigger)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding Movimentacoes}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" MaxHeight="260" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat='dd/MM HH:mm', Mode=OneWay}" Width="85" />
                                <DataGridTextColumn Header="De" Binding="{Binding Anterior, Mode=OneWay}" Width="45" />
                                <DataGridTextColumn Header="Para" Binding="{Binding Novo, Mode=OneWay}" Width="45" />
                                <DataGridTextColumn Header="Origem" Binding="{Binding Origem, Mode=OneWay}" Width="*" />
                                <DataGridTextColumn Header="Usuário" Binding="{Binding Usuario, Mode=OneWay}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
