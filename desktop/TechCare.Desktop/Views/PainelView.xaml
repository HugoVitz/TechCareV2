<UserControl x:Class="TechCare.Desktop.Views.PainelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="De" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding De}" Width="130" Margin="0,0,12,0" />
                <TextBlock Text="Até" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding Ate}" Width="130" Margin="0,0,12,0" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" />
                <TextBlock Text="{Binding Mensagem}" VerticalAlignment="Center" Style="{StaticResource Rotulo}" />
            </StackPanel>

            <WrapPanel>
                <Border Style="{StaticResource Cartao}" Width="220">
                    <StackPanel>
                        <TextBlock Text="Faturamento" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Resumo.Faturamento, StringFormat='R$ {0:N2}'}" Style="{StaticResource Valor}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Cartao}" Width="220">
                    <StackPanel>
                        <TextBlock Text="Ordens concluídas" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Resumo.Ordens}" Style="{StaticResource Valor}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Cartao}" Width="220">
                    <StackPanel>
                        <TextBlock Text="Ticket médio" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Resumo.TicketMedio, StringFormat='R$ {0:N2}'}" Style="{StaticResource Valor}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Cartao}" Width="220">
                    <StackPanel>
                        <TextBlock Text="Descontos concedidos" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Resumo.Descontos, StringFormat='R$ {0:N2}'}" Style="{StaticResource Valor}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <TextBlock Text="Faturamento dos últimos 6 meses (function fn_faturamento_mensal)" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Meses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding Mes}" Width="80" VerticalAlignment="Center" />
                                    <Rectangle Width="{Binding Largura}" Height="18" Fill="{StaticResource CorPrincipal}" RadiusX="3" RadiusY="3" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Run Text="{Binding Faturamento, StringFormat='R$ {0:N2}', Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding Ordens, Mode=OneWay}" />
                                        <Run Text="OS" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
