<Window x:Class="TechCare.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TechCare.Desktop.Views"
        Title="TechCare Desktop" Width="1100" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CorFundo}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource CorPrincipal}" Padding="16,10">
            <DockPanel>
                <TextBlock Text="TechCare Desktop" Foreground="White" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{Binding Cabecalho}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <TabControl Margin="12" Padding="12">
            <TabItem Header="Painel de indicadores">
                <views:PainelView DataContext="{Binding Painel}" />
            </TabItem>
            <TabItem Header="Estoque">
                <views:EstoqueView DataContext="{Binding Estoque}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
