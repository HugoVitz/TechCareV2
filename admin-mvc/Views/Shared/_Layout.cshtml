<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "TechCare") - TechCare Console do Dono</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #f3f5f9; }
        .navbar-brand span { color: #60a5fa; }
        .card-kpi { border: 0; border-left: 4px solid #2563eb; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .table-wrap { background: #fff; border-radius: .5rem; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .badge-status { font-weight: 600; }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Tech<span>Care</span> Console do Dono</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Painel</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Lojas" asp-action="Index">Lojas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuários</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Sessoes" asp-action="Index">Sessões</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Relatorios" asp-action="Diversidade">Diversidade</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Relatorios" asp-action="Auditoria">Auditoria</a></li>
                    </ul>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center gap-2">
                        <span class="text-light small">@User.Identity!.Name (Dono)</span>
                        <button class="btn btn-outline-light btn-sm" type="submit">Sair</button>
                    </form>
                </div>
            </div>
        </nav>
    }

    <main class="container pb-5">
        @await Html.PartialAsync("_Mensagens")
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
