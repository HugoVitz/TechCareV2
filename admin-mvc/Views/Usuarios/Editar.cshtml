@model EditarUsuarioVm
@{ ViewData["Title"] = "Editar usuário"; var etnias = ViewData["Etnias"] as string[] ?? Array.Empty<string>(); }
<h1 class="h4 mb-3">Editar usuário <small class="text-muted">@Model.UsuarioNome</small></h1>
<form asp-action="Editar" method="post" class="card p-4 shadow-sm" style="max-width:560px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="LojaId" />
    <input type="hidden" asp-for="UsuarioNome" />
    <div class="mb-3"><label asp-for="Nome" class="form-label">Nome</label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Cargo" class="form-label">Cargo</label><input asp-for="Cargo" class="form-control" /></div>
    <div class="mb-3">
        <label asp-for="Perfil" class="form-label">Perfil</label>
        <select asp-for="Perfil" class="form-select">
            <option value="Admin">Administrador</option>
            <option value="Atendente">Atendente</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Etnia" class="form-label">Etnia (opcional)</label>
        <select asp-for="Etnia" class="form-select">
            <option value="">—</option>
            @foreach (var e in etnias) { <option value="@e">@e</option> }
        </select>
    </div>
    <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Salvar</button><a class="btn btn-outline-secondary" asp-action="Index" asp-route-lojaId="@Model.LojaId">Cancelar</a></div>
</form>
