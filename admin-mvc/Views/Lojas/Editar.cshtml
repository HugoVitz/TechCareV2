@model EditarLojaVm
@{ ViewData["Title"] = "Editar loja"; }
<h1 class="h4 mb-3">Editar loja</h1>
<form asp-action="Editar" method="post" class="card p-4 shadow-sm" style="max-width:560px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label asp-for="Nome" class="form-label">Nome da loja</label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="VencimentoEm" class="form-label">Pago até (vencimento)</label><input asp-for="VencimentoEm" type="date" class="form-control" /><div class="form-text">Vazio = sem vencimento.</div></div>
    <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Salvar</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div>
</form>
