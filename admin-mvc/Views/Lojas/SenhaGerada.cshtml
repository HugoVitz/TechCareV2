@model SenhaGeradaVm
@{ ViewData["Title"] = "Senha provisória"; }
<div class="card p-4 shadow-sm" style="max-width:560px">
    <h1 class="h5">@Model.Contexto</h1>
    <dl class="row mb-3">
        <dt class="col-4">Usuário</dt><dd class="col-8"><code>@Model.Usuario</code></dd>
        <dt class="col-4">Senha provisória</dt><dd class="col-8"><code class="fs-5">@Model.Senha</code></dd>
    </dl>
    <p class="text-muted small mb-3">Esta senha aparece só agora e não pode ser consultada depois. No primeiro acesso a pessoa será obrigada a criar uma senha própria.</p>
    <a class="btn btn-primary" asp-controller="Lojas" asp-action="Index">Voltar às lojas</a>
</div>
